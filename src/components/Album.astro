---
import Track from "./Track.astro";
import type { album } from "../lib";
export type Props = album & { upc: string };
const { name, upc, artists, release, tracks } = Astro.props;
---

<div>
    <a href={`/lyrics/${upc}`} id={upc}>
        {name} by {artists.join(", ")}
    </a>
    <span>
        Released {release}, UPC: {upc}
    </span>
    {tracks.map((t) => <Track {...t} />)}
</div>

<style>
    div {
        border-radius: 20px;
        border: 1px solid #202020;
        padding: 10px;
        margin: 5px;
    }

    a,
    span {
        font-size: 1.5em;
    }

    a {
        font-weight: 700;
        text-decoration: none;
        color: white;
    }

    span {
        font-weight: 500;
        float: right;
    }
</style>
