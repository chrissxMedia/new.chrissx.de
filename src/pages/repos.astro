---
import { Octokit } from "@octokit/rest";
import Layout from "../layouts/Layout.astro";

const octokit = new Octokit();
const repos = await octokit.paginate(octokit.rest.repos.listForOrg, {
    org: "chrissxMedia",
    type: "public",
    sort: "pushed",
    direction: "desc",
});
---

<Layout title="Repositories">
    <h2>Our Open Source Projects</h2>
    <ul>
        {
            repos.filter((repo) => !repo.archived).map((repo) => (
                <li>
                    <a href={repo.homepage?.trim() || repo.html_url}>
                        <h3>{repo.name}</h3>
                        {repo.description && <p>{repo.description}</p>}
                    </a>
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    ul {
        display: flex;
        flex-flow: row wrap;
        gap: 1em;
        padding: 0;
    }
    li {
        flex: 1 1 16rem;
        min-width: 0;
        list-style: none;
        display: flex;
        padding: 0.25rem;
        background-color: #202020;
        color: #ffffff;
        background-image: none;
        background-size: 400%;
        border-radius: 0.8rem;
        background-position: 100%;
        transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        box-shadow:
            0 4px 6px -1px rgba(0, 0, 0, 0.1),
            0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }
    li > a {
        width: 100%;
        min-width: 0;
        overflow-wrap: anywhere;
        text-decoration: none;
        line-height: 1.4;
        padding: 1rem 1.3rem;
        border-radius: 0.35rem;
        color: #ffffff;
        background-color: #202020;
        opacity: 0.8;
    }
    h3 {
        margin: 0;
        font-size: 1.25em;
        transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    p {
        margin-top: 0.5rem;
        margin-bottom: 0;
        color: #cccccc;
        font-family: var(--unifont);
    }
    li:is(:hover, :focus-within) {
        background-position: 0;
        background-image: linear-gradient(
            45deg,
            rgb(var(--cmpurple)),
            rgb(var(--cmred)) 30%,
            white 60%
        );
    }
    li:is(:hover, :focus-within) h3 {
        color: rgb(var(--cmpurple));
    }
</style>
