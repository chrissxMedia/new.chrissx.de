---
import { LinkCard } from "cmdesigns";

export interface Props {
    href: string;
    title?: string;
    subtitle?: string;
    image?: string;
    rel?: string;
}

const { href, title, subtitle, image, rel } = Astro.props;
---

<LinkCard class="card" {href} {rel}>
    {image && <img src={image} alt="" width="48" height="48" loading="lazy" onerror="this.remove()" />}
    {title && <span><strong>{title}</strong>{subtitle && <small>{subtitle}</small>}</span>}
    <slot />
</LinkCard>

<style>
    .card > :global(.content) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--unifont);
    }
    img {
        max-width: 100%;
        height: auto;
        flex-shrink: 0;
    }
    img[src*=".svg"] {
        filter: invert(1);
    }
    img:not([src*=".svg"]) {
        border-radius: 0.5rem;
    }
    span {
        min-width: 0;
    }
    small {
        display: block;
        color: #cccccc;
    }
</style>
