---
import Layout from "../../../layouts/Layout.astro";
import { albums } from "../../../lib";
import Album from "../../../components/Album.astro";
import Search from "../../../components/Search.astro";
import FormatTabs from "../../../components/FormatTabs.astro";

export function getStaticPaths() {
    return albums.map(({ upc }) => ({ params: { upc: upc!.toString() } }));
}

const { upc } = Astro.params;
const album = albums.find((a) => a.upc === +upc);

if (!album) {
    return new Response("Album not found", { status: 404 });
}
---

<Layout title={`${album.name} | chrissx Media Lyrics Department`}>
    <p>
        All content displayed on this web page is the intellectual property of
        chrissx Media. All rights reserved. Do not distribute without written
        permission.
    </p>
    <Search />
    <FormatTabs />
    <Album {...album} />
</Layout>

<style>
    :global(main) {
        font-family: var(--sans-serif);
    }
</style>
