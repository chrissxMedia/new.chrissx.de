---
import { BaseLayout, CMText, Footer } from "cmdesigns";
import favicon from "../favicon.png";

export interface Props {
    title: string;
    lang?: string;
    width?: "normal" | "full" | "content";
}

const { title, lang = "en", width = "normal" } = Astro.props;
---

<BaseLayout
    {lang}
    {favicon}
    {title}
    description="The official chrissx Media website"
    themecolor="#000000"
>
    <slot name="head" slot="head" />
    <link rel="alternate" type="application/rss+xml" title="chrissx Media notices" href="/notices/rss.xml" slot="head" />
    <div class:list={["page", width]}>
        <header>
            <h1><a href="/"><CMText /></a></h1>
            <nav>
                <a href="/hmmg">HMMG</a>
                <a href="/streams">Livestreams</a>
                <a href="/repos">Repositories</a>
                <!--<a href="/shop">Merchandise</a>-->
            </nav>
        </header>
        <main>
            <slot />
            <Footer start={2018} />
        </main>
    </div>
</BaseLayout>

<style>
    .page {
        max-width: 60rem;
        margin: 0 auto;
    }
    .full {
        max-width: none;
    }
    .content {
        width: max-content;
        max-width: 100%;
    }
    header {
        text-align: center;
        padding-bottom: 1em;
    }
    nav {
        display: flex;
        flex-flow: row wrap;
        justify-content: center;
        gap: 0.5em;
    }
    h1 {
        font-size: 40px;
        margin: 0.25em 0;
    }
    h1 a {
        text-decoration: none;
    }
</style>

<style is:global>
    body {
        font-family: var(--minecraft);
        font-size: 18px;
        padding: 0 1rem;
    }
    :link,
    :visited {
        color: #aaaaaa;
    }
</style>
