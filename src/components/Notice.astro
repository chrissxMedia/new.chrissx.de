---
import { render, type CollectionEntry } from "astro:content";
import "remark-github-blockquote-alert/alert.css";

type Props = CollectionEntry<"notices"> & { mode: "list" | "standalone" };

const {
    id,
    data: { title, date, archived },
    mode,
} = Astro.props;
const { Content } = await render(Astro.props);
---

{
    mode === "standalone" ? (
        <div class="title">
            <h2>{title}</h2>
            <span style={{color: archived ? "green" : "red"}}>{date}</span>
        </div>
    ) : (
        <a href={`/notices/${id}`} class="title">
            <h3>{title}</h3>
            <span>{date}</span>
        </a>
    )
}
<div class="md">
    <Content />
</div>

<style>
    .md, .title {
        font-family: var(--sans-serif);
    }
    span, .md :global(code) {
        font-family: var(--unifont);
    }
    .title {
        display: flex;
        flex-flow: row nowrap;
        justify-content: space-between;
        gap: 1em;
    }
    span {
        gap: 0.5em;
        height: min-content;
        margin: auto 0;
    }
    a, :visited {
        color: white;
        text-decoration: none;
    }
</style>
