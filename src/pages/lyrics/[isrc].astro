---
import LyricsLayout from "../../layouts/LyricsLayout.astro";
import Track from "../../components/Track.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const tracks = (await getCollection("albums")).flatMap((a) => a.data.tracks);
    return tracks.map(({ isrc }) => ({ params: { isrc: isrc.raw } }));
}

const { isrc } = Astro.params;
const albums = await getCollection("albums");
const album = albums.find((a) => a.data.tracks.some((t) => t.isrc.raw === isrc));
const track = album?.data.tracks.find((t) => t.isrc.raw === isrc);

if (!track) {
    return new Response("Track not found", { status: 404 });
}
---

<LyricsLayout
    title={track.name}
    description={`${track.lyrics ? "Lyrics and track information" : "Track information"} for ${track.name} by ${track.artists.join(", ")}.`}
    image={album?.data.cover}
>
    <Track {...track} />
</LyricsLayout>
