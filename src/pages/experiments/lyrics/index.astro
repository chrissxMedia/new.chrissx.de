---
import LyricsLayout from "../../../layouts/LyricsLayout.astro";
import Album from "../../../components/Album.astro";
import { getCollection } from "astro:content";

const albums = await getCollection("albums");
---

<LyricsLayout>
    {albums.toSorted((a, b) => b.data.release.localeCompare(a.data.release)).map((a) => <Album {...a.data} />)}
</LyricsLayout>

<style>
    :global(body) {
        padding: 8px;
        font-size: 12pt;
    }
</style>
