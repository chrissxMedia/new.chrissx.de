---
import Layout from "./Layout.astro";
import Search from "../components/Search.astro";
import FormatTabs from "../components/FormatTabs.astro";
import type { ComponentProps } from "astro/types";

interface Props extends Omit<ComponentProps<typeof Layout>, "title" | "width"> {
    title?: string;
    width?: "normal" | "full";
}

let {
    title,
    width,
    description = "Browse chrissx Media releases and song lyrics.",
    ...seo
} = Astro.props;
const x = "chrissx Media Lyrics Department";
title = title ? `${title} | ${x}` : x;
---

<Layout {title} {width} {description} {...seo}>
    <slot name="head" slot="head" />
    <p>
        All content displayed on this web page is the intellectual property of
        chrissx Media. All rights reserved. Do not distribute without written
        permission.
    </p>
    <div>
        <FormatTabs />
        <Search class="search" />
    </div>
    <slot />
</Layout>

<style>
    :global(main) {
        font-family: var(--sans-serif);
    }
    div {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
    }
    div > .search {
        flex: 0 0 auto;
        margin-left: auto;
    }
</style>
