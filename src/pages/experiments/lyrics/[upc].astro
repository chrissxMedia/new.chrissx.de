---
import LyricsLayout from "../../../layouts/LyricsLayout.astro";
import { albums } from "../../../lib";
import Album from "../../../components/Album.astro";

export function getStaticPaths() {
    return albums.map(({ upc }) => ({ params: { upc: upc! } }));
}

const { upc } = Astro.params;
const album = albums.find((a) => a.upc === upc);

if (!album) {
    return new Response("Album not found", { status: 404 });
}
---

<LyricsLayout title={album.name}>
    <Album {...album} />
</LyricsLayout>
