---
import g2mm from "g2mm";
import { DEFAULT_FORMAT } from "../lyrics-format";

const { name, isrc, length, lyrics, artists } = Astro.props;
const defaultLyrics = lyrics ? g2mm(lyrics, DEFAULT_FORMAT) : undefined;
---

<div class="track">
    <a href={isrc} id={isrc}>
        {name} by {artists.join(", ")}
    </a>
    <span>
        {
            lyrics && (
                <button class="track-clipboard">
                    Copy Lyrics
                </button>
            )
        } Length: {length}, ISRC: {isrc}
    </span>
    {defaultLyrics && <p class="lyrics" data-lyrics={lyrics}>{defaultLyrics}</p>}
</div>

<script>
    import g2mm from "g2mm";
    import { FORMAT_EVENT } from "../lyrics-format";

    type Format = "genius" | "musixmatch" | "plain";

    document
        .querySelectorAll<HTMLElement>("p.lyrics")
        .forEach((el) => {
            const raw = el.getAttribute("data-lyrics")!;
            const apply = (fmt: Format) => {
                el.textContent = g2mm(raw, fmt);
            };
            document.addEventListener(
                FORMAT_EVENT,
                (e: Event) => apply((e as CustomEvent<Format>).detail),
            );

            const btn = el.parentElement!.querySelector<HTMLButtonElement>(
                "button.track-clipboard",
            );
            btn?.addEventListener("click", () => {
                navigator.clipboard
                    .writeText(el.textContent!)
                    .then(() => {
                        btn.innerHTML = "Copied Lyrics";
                        setTimeout(() => (btn.innerHTML = "Copy Lyrics"), 1500);
                    });
            });
        });
</script>

<style>
    .track {
        background-color: #101010;
        border-radius: 20px;
        padding: 5px;
        margin: 5px;
    }

    a,
    span {
        font-size: 24px;
    }

    a {
        font-weight: 700;
        text-decoration: none;
        color: white;
    }

    span {
        float: right;
        font-weight: 500;
    }

    .track-clipboard {
        border-radius: 20px;
        background-color: #101010;
        color: white;
        border-color: white;
        margin-right: 10px;
        font-size: 16px;
        font-weight: 400;
    }

    .lyrics {
        white-space: pre-wrap;
    }
</style>
