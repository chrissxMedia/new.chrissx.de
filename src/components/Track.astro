---
const { name, isrc, length, lyrics, artists } = Astro.props;
---

<div class="track">
    <a href={isrc} id={isrc}>
        {name} by {artists.join(", ")}
    </a>
    <span>
        {
            lyrics && (
                <button class="track-clipboard">
                    Copy Lyrics
                </button>
            )
        } Length: {length}, ISRC: {isrc}
    </span>
    {lyrics && <p class="lyrics">{lyrics}</p>}
</div>

<script>
    import g2mm from "g2mm";
    import type { LyricStyle } from "g2mm";
    import {
        DEFAULT_FORMAT,
        FORMAT_EVENT,
        STORAGE_KEY,
    } from "../lyrics-format";

    function stored(): LyricStyle {
        try {
            const v = localStorage.getItem(STORAGE_KEY);
            return v === "genius" || v === "musixmatch" || v === "plain"
                ? v
                : DEFAULT_FORMAT;
        } catch {
            return DEFAULT_FORMAT;
        }
    }

    document
        .querySelectorAll<HTMLElement>("p.lyrics")
        .forEach((p) => {
            const raw = p.textContent;
            const update = (fmt: LyricStyle) => {
                p.textContent = g2mm(raw, fmt);
            };
            update(stored());
            document.addEventListener(
                FORMAT_EVENT,
                (e: Event) => update((e as CustomEvent<LyricStyle>).detail),
            );
        });

    document
        .querySelectorAll<HTMLButtonElement>("button.track-clipboard")
        .forEach((btn) => {
            const p = btn.closest(".track")?.querySelector("p.lyrics");
            if (!p) return;
            btn.addEventListener("click", () => {
                navigator.clipboard
                    .writeText(p.textContent)
                    .then(() => {
                        btn.innerHTML = "Copied Lyrics";
                        setTimeout(() => (btn.innerHTML = "Copy Lyrics"), 1500);
                    });
            });
        });
</script>

<style>
    .track {
        background-color: #101010;
        border-radius: 20px;
        padding: 5px;
        margin: 5px;
    }

    a,
    span {
        font-size: 24px;
    }

    a {
        font-weight: 700;
        text-decoration: none;
        color: white;
    }

    span {
        float: right;
        font-weight: 500;
    }

    .track-clipboard {
        border-radius: 20px;
        background-color: #101010;
        color: white;
        border-color: white;
        margin-right: 10px;
        font-size: 16px;
        font-weight: 400;
    }

    .lyrics {
        white-space: pre-wrap;
    }
</style>
