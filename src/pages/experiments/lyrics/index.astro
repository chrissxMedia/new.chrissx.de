---
import Layout from "../../../layouts/Layout.astro";
import { albums } from "../../../lib";
import Album from "../../../components/Album.astro";
import Search from "../../../components/Search.astro";
import FormatTabs from "../../../components/FormatTabs.astro";
---

<Layout title="chrissx Media Lyrics Department">
    <p>
        All content displayed on this web page is the intellectual property of
        chrissx Media. All rights reserved. Do not distribute without written
        permission.
    </p>
    <div class="controls">
        <FormatTabs />
        <Search />
    </div>
    {albums.toReversed().map((a) => <Album {...a} />)}
</Layout>

<style>
    :global(body) {
        padding: 8px;
        font-size: 12pt;
    }
    :global(main) {
        font-family: var(--sans-serif);
    }
    .controls {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
    }
    .controls pagefind-searchbox {
        flex: 0 0 auto;
        margin-left: auto;
    }
</style>
