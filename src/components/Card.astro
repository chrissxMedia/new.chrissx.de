---
export interface Props {
    href: string;
    title?: string;
    subtitle?: string;
    image?: string;
    rel?: string;
}

const { href, title, subtitle, image, rel } = Astro.props;
---

<a href={href} rel={rel}>
    {image && <img src={image} alt="" width="48" height="48" loading="lazy" onerror="this.remove()" />}
    {title && <span><strong>{title}</strong>{subtitle && <small>{subtitle}</small>}</span>}
    <slot />
</a>

<style>
    a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
        padding: 1rem;
        border: 1px solid #333333;
        border-radius: 0.8rem;
        background: #0f0f0f;
        color: #ffffff;
        font-family: var(--unifont);
        text-decoration: none;
        overflow-wrap: anywhere;
    }
    a:is(:hover, :focus-visible) {
        background: #333333;
    }
    img {
        max-width: 100%;
        height: auto;
        flex-shrink: 0;
    }
    img[src*=".svg"] {
        filter: invert(1);
    }
    img:not([src*=".svg"]) {
        border-radius: 0.5rem;
    }
    span {
        min-width: 0;
    }
    small {
        display: block;
        color: #cccccc;
    }
</style>
