---
import Layout from "../layouts/Layout.astro";
import NoticeList from "../components/NoticeList.astro";
import { getCollection } from "astro:content";

const notices = (await getCollection("notices")).filter((x) => !x.data.archived);
---

<Layout title="chrissx Media">
    <h3>Subsidiaries and befriended projects</h3>
    <a href="//fuxgames.com/">Fux Games</a><br />
    <a href="//lowlevelmusic.com/">Low Level Music</a><br />
    <a href="//zerm.eu/">ZERM</a><br />
    <!--<a href="/qa">Quod Arbor</a><br />-->

    <h3>Our social media</h3>
    <a href="//twitter.com/chrissxMedia">Twitter</a><br />
    <a rel="me" href="//mastodon.online/@chrissx">Mastodon</a><br />
    <a href="/discord">Discord</a><br />
    <a href="//github.com/chrissxMedia">GitHub</a><br />
    <!--TODO: instagram-->
    <h4>YouTube</h4>
    <a href="//youtube.com/@chrissxMedia">chrissx Media</a><br />
    <a href="//youtube.com/@pixelcmtd">XXLP</a><br />
    <a href="//youtube.com/@pixeleng">Pixel Engineering</a><br />
    <a href="//youtube.com/@chrissxReuploads">chrissx Reuploads</a><br />
    <a href="//youtube.com/@twinkspotting">Twinkspotting</a><br />

    <br /><br />

    <NoticeList {notices} placeholder="There are no active notices.">
        <h2 slot="before" id="notices">Notices (upcoming changes and maintenance)</h2>
        <a slot="after" href="/notices/archive">View archived notices</a>
    </NoticeList>
</Layout>
