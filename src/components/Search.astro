---
const base = "/lyrics/";
const bundle = `${base}search/`;
---

{
    import.meta.env.DEV ? (
        <p {...Astro.props}>Search is not available in dev mode.</p>
    ) : (
        <link href={`${bundle}pagefind-component-ui.css`} rel="stylesheet" />
        <script src={`${bundle}pagefind-component-ui.js`} is:inline type="module" />
        <pagefind-config preload base-url={base} bundle-path={bundle} />
        <pagefind-searchbox shortcut="/" {...Astro.props} />
    )
}

<style is:global>
    pagefind-searchbox {
        --pf-text: #ffffff;
        --pf-text-secondary: #c0c0c0;
        --pf-text-muted: #a0a0a0;
        --pf-background: #000000;
        --pf-border: #808080;
        --pf-border-focus: #ffffff;
        --pf-skeleton: #2a2a2a;
        --pf-skeleton-shine: #333;
        --pf-hover: #252525;
        --pf-mark: #e5e5e5;
        --pf-scroll-shadow: rgba(255, 255, 255, 0.1);

        --pf-outline-focus: transparent;

        --pf-shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
        --pf-shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
        --pf-shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.5);

        --pf-error-bg: #2a1a1a;
        --pf-error-border: #5c2828;
        --pf-error-text: #f87171;
        --pf-error-text-secondary: #ef4444;
    }
</style>
