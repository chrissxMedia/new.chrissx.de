---
import { Octokit } from "@octokit/rest";
import { LinkCard } from "cmdesigns";
import Layout from "../layouts/Layout.astro";

const octokit = new Octokit();
const repos = await octokit.paginate(octokit.rest.repos.listForOrg, {
    org: "chrissxMedia",
    type: "public",
    sort: "pushed",
    direction: "desc",
});
---

<Layout title="Repositories">
    <h2>Our Open Source Projects</h2>
    <ul>
        {
            repos.filter((repo) => !repo.archived).map((repo) => (
                <li>
                    <LinkCard
                        class="repo-card"
                        href={repo.homepage?.trim() || repo.html_url}
                        highlightBackground="linear-gradient(45deg, rgb(var(--cmpurple)), rgb(var(--cmred)))"
                    >
                        <h3>{repo.name}</h3>
                        {repo.description && <p>{repo.description}</p>}
                    </LinkCard>
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1em;
        padding: 0;
    }
    li {
        flex: 1 1 16rem;
        min-width: 0;
        list-style: none;
        display: flex;
    }
    .repo-card {
        width: 100%;
    }
    li > .repo-card[data-frame] > :global(.content) {
        line-height: 1.4;
        padding: 1rem 1.3rem;
    }
    h3 {
        margin: 0;
        font-size: 1.25em;
        transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    p {
        margin: 0.5rem 0 0;
        color: #cccccc;
        font-family: var(--unifont);
    }
    .repo-card:is(:hover, :focus-visible) h3 {
        color: rgb(var(--cmpurple));
    }
</style>
