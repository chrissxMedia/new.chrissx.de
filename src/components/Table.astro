---
export interface Props {
    headers: string[];
    lines: string[][];
}

const { headers, lines } = Astro.props;

const emojify = (c: string) => (c == "y" ? "✅" : c == "n" ? "❌" : c);
const linkify = (c: string) =>
    c.startsWith("https://") ? `<a href="${c}">${c}</a>` : c;
---

<div class="table-scroll" tabindex="0">
    <table>
        <thead>
            <tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr>
        </thead>
        <tbody>
            {
                lines.map((l) => (
                    <tr>
                        {l.map(emojify).map(linkify).map((x) => (<td set:html={x} />))}
                    </tr>
                ))
            }
        </tbody>
    </table>
</div>

<style>
    .table-scroll {
        overflow-x: auto;
    }
    table {
        margin: 0.5em;
        padding: 0.5em;
        border: 1px solid white;
        border-radius: 0.25em;
    }
    td {
        vertical-align: inherit;
        padding-left: 0.25em;
        padding-right: 0.25em;
    }
</style>
