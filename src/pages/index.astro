---
import Layout from "../layouts/Layout.astro";
import NoticeList from "../components/NoticeList.astro";
import Card from "../components/Card.astro";
import { youtubeAvatars } from "../youtube";
import { getCollection } from "astro:content";
import twitterLogo from "simple-icons/icons/twitter.svg?url&no-inline";
import mastodonLogo from "simple-icons/icons/mastodon.svg?url&no-inline";
import githubLogo from "simple-icons/icons/github.svg?url&no-inline";
import discordLogo from "simple-icons/icons/discord.svg?url&no-inline";
// TODO: Move the Fux Games logo into cmdesigns.
import fuxLogo from "../fux-games.png";

const notices = (await getCollection("notices")).filter((x) => !x.data.archived);

const socials = [
    {
        title: "Twitter",
        subtitle: "@chrissxMedia",
        href: "https://twitter.com/chrissxMedia",
        image: twitterLogo,
    },
    {
        title: "Mastodon",
        subtitle: "@chrissx@mastodon.online",
        href: "https://mastodon.online/@chrissx",
        image: mastodonLogo,
        rel: "me",
    },
    {
        title: "GitHub",
        subtitle: "@chrissxMedia",
        href: "https://github.com/chrissxMedia",
        image: githubLogo,
    },
    {
        title: "Discord",
        href: "https://chrissx.de/discord",
        image: discordLogo,
    },
];

const channels = [
    { title: "chrissx Media", handle: "chrissxMedia", id: "UCZs3FO5nPvK9VveqJLIvv_w" },
    { title: "XXLP", handle: "pixelcmtd", id: "UCF7z3rssaZjx7SxJ0IqSNvw" },
    { title: "Pixel Engineering", handle: "pixeleng", id: "UC20oDKphj67NRDwKKy3JC_A" },
    { title: "chrissx Reuploads", handle: "chrissxReuploads", id: "UCBB0O-hjdgCISLi1jTINwRg" },
    { title: "Twinkspotting", handle: "twinkspotting", id: "UCMawD8L365TRdcqhQiTDLKA" },
];
const avatars = await youtubeAvatars(channels.map((channel) => channel.id));
---

<Layout title="chrissx Media">
    <h3>Subsidiaries and befriended projects</h3>
    <div class="links projects">
        <Card title="Fux Games" href="https://fuxgames.com/" image={fuxLogo.src} />
        <Card href="https://lowlevelmusic.com/">
            <strong class="llm">Low Level Music</strong>
        </Card>
        <Card href="https://zerm.eu/">
            <span class="zerm">ZERM</span>
        </Card>
    </div>
    <!--<a href="/qa">Quod Arbor</a><br />-->

    <h3>Our social media</h3>
    <div class="links">
        {socials.map((social) => <Card {...social} />)}
        {channels.map((channel, i) => (
            <Card
                title={`${channel.title} · YouTube`}
                subtitle={`@${channel.handle}`}
                href={`https://www.youtube.com/@${channel.handle}`}
                image={avatars[i]}
            />
        ))}
    </div>

    <NoticeList {notices} placeholder="There are no active notices.">
        <h2 slot="before" id="notices">Notices (upcoming changes and maintenance)</h2>
        <a slot="after" href="/notices/archive">View archived notices</a>
    </NoticeList>
</Layout>

<style>
    .links {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        gap: 1em;
        margin-bottom: 1.5em;
    }
    .projects > :global(a) {
        justify-content: center;
        text-align: center;
    }
    .llm {
        font-family: var(--minecraft);
    }
    .zerm {
        font-family: var(--woodcut);
        font-size: 1.5rem;
        /* Center Woodcut's visible capitals within its line box. */
        transform: translateY(0.11em);
    }
</style>
